{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "SOC 2 control compliance posture over time. Pulls Prowler / Kubescape / kube-bench / TruffleHog / Falco / FIM findings from the Wazuh indexer (wazuh-alerts-*) and surfaces pass/fail rates, severity trends, top failing controls and recent critical findings. The collapsed bottom row keeps scanner liveness as operational context.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "Posture (current window)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "title": "Open Critical Findings",
      "description": "Critical SOC2 findings raised by Wazuh (rule.groups: soc2_critical OR data.Severity:critical OR rule.level>=13) in the selected window.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "${ds_wazuh}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "short",
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false } },
      "targets": [
        {
          "refId": "A",
          "query": "rule.groups:soc2_critical OR data.Severity:critical OR rule.level:>=13",
          "alias": "critical",
          "bucketAggs": [
            { "type": "date_histogram", "field": "@timestamp", "id": "2", "settings": { "interval": "auto", "min_doc_count": "0", "trimEdges": "0" } }
          ],
          "metrics": [ { "type": "count", "id": "1" } ],
          "timeField": "@timestamp"
        }
      ]
    },
    {
      "title": "Open High Findings",
      "description": "High-severity SOC2 findings (data.Severity:high or rule.level 10-12) in the window.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "${ds_wazuh}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 10 }, { "color": "orange", "value": 50 } ] },
          "unit": "short", "color": { "mode": "thresholds" }
        }
      },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false } },
      "targets": [
        {
          "refId": "A",
          "query": "(data.Severity:high OR rule.level:[10 TO 12]) AND rule.groups:soc2_fail",
          "alias": "high",
          "bucketAggs": [ { "type": "date_histogram", "field": "@timestamp", "id": "2", "settings": { "interval": "auto" } } ],
          "metrics": [ { "type": "count", "id": "1" } ],
          "timeField": "@timestamp"
        }
      ]
    },
    {
      "title": "Total SOC2 Failures",
      "description": "All SOC2 control failures in the window (rule.groups: soc2_fail). Spans Prowler, Kubescape, kube-bench, TruffleHog, Falco.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "${ds_wazuh}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 50 }, { "color": "orange", "value": 200 } ] },
          "unit": "short"
        }
      },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false } },
      "targets": [
        {
          "refId": "A",
          "query": "rule.groups:soc2_fail",
          "alias": "fail",
          "bucketAggs": [ { "type": "date_histogram", "field": "@timestamp", "id": "2", "settings": { "interval": "auto" } } ],
          "metrics": [ { "type": "count", "id": "1" } ],
          "timeField": "@timestamp"
        }
      ]
    },
    {
      "title": "Prowler Pass Rate",
      "description": "Ratio of Prowler PASS to total checks (PASS+FAIL). Approximate proxy for SOC 2 cloud-control compliance %. Pulls rule.groups:prowler_compliance docs and uses data.Status.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "${ds_wazuh}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 70 }, { "color": "yellow", "value": 90 }, { "color": "green", "value": 95 } ] },
          "unit": "percent", "min": 0, "max": 100
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        {
          "refId": "A",
          "query": "rule.groups:prowler_compliance AND data.Status:PASS",
          "alias": "PASS",
          "bucketAggs": [ { "type": "date_histogram", "field": "@timestamp", "id": "2", "settings": { "interval": "auto" } } ],
          "metrics": [ { "type": "count", "id": "1" } ],
          "timeField": "@timestamp"
        },
        {
          "refId": "B",
          "query": "rule.groups:prowler_compliance AND (data.Status:FAIL OR data.Status:MANUAL)",
          "alias": "FAIL",
          "bucketAggs": [ { "type": "date_histogram", "field": "@timestamp", "id": "2", "settings": { "interval": "auto" } } ],
          "metrics": [ { "type": "count", "id": "1" } ],
          "timeField": "@timestamp"
        }
      ]
    },
    {
      "title": "Verified Secret Leaks",
      "description": "TruffleHog verified secret findings (rule.id:100601). Verified=true means the credential is currently usable.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "${ds_wazuh}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] },
          "unit": "short", "color": { "mode": "thresholds" }
        }
      },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false } },
      "targets": [
        {
          "refId": "A",
          "query": "rule.id:100601",
          "alias": "verified",
          "bucketAggs": [ { "type": "date_histogram", "field": "@timestamp", "id": "2", "settings": { "interval": "auto" } } ],
          "metrics": [ { "type": "count", "id": "1" } ],
          "timeField": "@timestamp"
        }
      ]
    },
    {
      "title": "FIM Critical Events (CC6.1)",
      "description": "File-integrity-monitoring events on sensitive paths (rule.groups:fim_critical). Trust criterion CC6.1.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "${ds_wazuh}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 } ] },
          "unit": "short"
        }
      },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false } },
      "targets": [
        {
          "refId": "A",
          "query": "rule.groups:fim_critical OR rule.groups:soc2_cc6",
          "alias": "fim",
          "bucketAggs": [ { "type": "date_histogram", "field": "@timestamp", "id": "2", "settings": { "interval": "auto" } } ],
          "metrics": [ { "type": "count", "id": "1" } ],
          "timeField": "@timestamp"
        }
      ]
    },
    {
      "type": "row",
      "title": "Compliance trend",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "collapsed": false
    },
    {
      "title": "Prowler PASS vs FAIL over time",
      "description": "Time series of Prowler check outcomes. Rising green / falling red = improving cloud control compliance.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "${ds_wazuh}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 25, "stacking": { "mode": "normal", "group": "A" } },
          "unit": "short"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "PASS" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
          { "matcher": { "id": "byName", "options": "FAIL" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum", "lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "query": "rule.groups:prowler_compliance AND data.Status:PASS",
          "alias": "PASS",
          "bucketAggs": [ { "type": "date_histogram", "field": "@timestamp", "id": "2", "settings": { "interval": "1h", "min_doc_count": "0" } } ],
          "metrics": [ { "type": "count", "id": "1" } ],
          "timeField": "@timestamp"
        },
        {
          "refId": "B",
          "query": "rule.groups:prowler_compliance AND data.Status:FAIL",
          "alias": "FAIL",
          "bucketAggs": [ { "type": "date_histogram", "field": "@timestamp", "id": "2", "settings": { "interval": "1h", "min_doc_count": "0" } } ],
          "metrics": [ { "type": "count", "id": "1" } ],
          "timeField": "@timestamp"
        }
      ]
    },
    {
      "title": "Findings by severity over time",
      "description": "All SOC2 failures (rule.groups:soc2_fail) bucketed by data.Severity. Tracks whether overall posture is improving.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "${ds_wazuh}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 80, "stacking": { "mode": "normal", "group": "A" } },
          "unit": "short"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "critical" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] },
          { "matcher": { "id": "byName", "options": "high" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] },
          { "matcher": { "id": "byName", "options": "medium" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } } ] },
          { "matcher": { "id": "byName", "options": "low" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "query": "rule.groups:soc2_fail",
          "alias": "{{term data.Severity.keyword}}",
          "bucketAggs": [
            { "type": "terms", "field": "data.Severity.keyword", "id": "3", "settings": { "size": "5", "order": "desc", "orderBy": "_count" } },
            { "type": "date_histogram", "field": "@timestamp", "id": "2", "settings": { "interval": "1h", "min_doc_count": "0" } }
          ],
          "metrics": [ { "type": "count", "id": "1" } ],
          "timeField": "@timestamp"
        }
      ]
    },
    {
      "type": "row",
      "title": "Top failing controls & scanners",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "collapsed": false
    },
    {
      "title": "Top 10 failing controls",
      "description": "Most frequent failing controls in the window — Prowler CheckTitle for cloud findings, Kubescape ControlID for k8s posture, kube-bench check name for node CIS.",
      "type": "bargauge",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "${ds_wazuh}" },
      "fieldConfig": {
        "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 5 }, { "color": "red", "value": 20 } ] }, "unit": "short" }
      },
      "options": { "orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true },
      "targets": [
        {
          "refId": "A",
          "query": "rule.groups:soc2_fail",
          "alias": "{{term data.CheckTitle.keyword}}",
          "bucketAggs": [
            { "type": "terms", "field": "data.CheckTitle.keyword", "id": "3", "settings": { "size": "10", "order": "desc", "orderBy": "_count", "missing": "(no CheckTitle)" } },
            { "type": "date_histogram", "field": "@timestamp", "id": "2", "settings": { "interval": "auto", "min_doc_count": "0" } }
          ],
          "metrics": [ { "type": "count", "id": "1" } ],
          "timeField": "@timestamp"
        }
      ]
    },
    {
      "title": "Failures by scanner",
      "description": "Share of SOC2 failures contributed by each scanner. Helps identify which control area drives most of the open findings.",
      "type": "piechart",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "${ds_wazuh}" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] }, "pieType": "donut", "reduceOptions": { "values": false, "calcs": ["sum"], "fields": "" } },
      "targets": [
        {
          "refId": "A",
          "query": "rule.groups:prowler_compliance AND rule.groups:soc2_fail",
          "alias": "Prowler",
          "bucketAggs": [ { "type": "date_histogram", "field": "@timestamp", "id": "2", "settings": { "interval": "auto" } } ],
          "metrics": [ { "type": "count", "id": "1" } ],
          "timeField": "@timestamp"
        },
        {
          "refId": "B",
          "query": "rule.groups:kubescape_attack",
          "alias": "Kubescape",
          "bucketAggs": [ { "type": "date_histogram", "field": "@timestamp", "id": "2", "settings": { "interval": "auto" } } ],
          "metrics": [ { "type": "count", "id": "1" } ],
          "timeField": "@timestamp"
        },
        {
          "refId": "C",
          "query": "rule.groups:kubebench_cis AND rule.groups:soc2_fail",
          "alias": "kube-bench (CIS)",
          "bucketAggs": [ { "type": "date_histogram", "field": "@timestamp", "id": "2", "settings": { "interval": "auto" } } ],
          "metrics": [ { "type": "count", "id": "1" } ],
          "timeField": "@timestamp"
        },
        {
          "refId": "D",
          "query": "rule.groups:trufflehog_secrets AND rule.groups:soc2_fail",
          "alias": "TruffleHog",
          "bucketAggs": [ { "type": "date_histogram", "field": "@timestamp", "id": "2", "settings": { "interval": "auto" } } ],
          "metrics": [ { "type": "count", "id": "1" } ],
          "timeField": "@timestamp"
        },
        {
          "refId": "E",
          "query": "rule.groups:fim_critical",
          "alias": "FIM (CC6.1)",
          "bucketAggs": [ { "type": "date_histogram", "field": "@timestamp", "id": "2", "settings": { "interval": "auto" } } ],
          "metrics": [ { "type": "count", "id": "1" } ],
          "timeField": "@timestamp"
        }
      ]
    },
    {
      "type": "row",
      "title": "Recent critical findings",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 },
      "collapsed": false
    },
    {
      "title": "Latest critical / high SOC2 findings",
      "description": "Most recent critical or high findings (rule.level >= 12 OR data.Severity:critical/high). Use this list to drive remediation.",
      "type": "table",
      "gridPos": { "h": 11, "w": 24, "x": 0, "y": 26 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "${ds_wazuh}" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "filterable": true } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Severity" }, "properties": [ { "id": "custom.cellOptions", "value": { "type": "color-background" } }, { "id": "mappings", "value": [
            { "type": "value", "options": { "critical": { "color": "red", "index": 0 }, "high": { "color": "orange", "index": 1 }, "medium": { "color": "yellow", "index": 2 }, "low": { "color": "blue", "index": 3 } } }
          ] } ] }
        ]
      },
      "options": { "showHeader": true, "sortBy": [ { "displayName": "Time", "desc": true } ] },
      "targets": [
        {
          "refId": "A",
          "query": "rule.groups:soc2_fail AND (data.Severity:critical OR data.Severity:high OR rule.groups:soc2_critical OR rule.level:>=12)",
          "alias": "",
          "metrics": [ { "type": "logs", "id": "1", "settings": { "limit": "100" } } ],
          "bucketAggs": [],
          "timeField": "@timestamp"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "_id": true, "_index": true, "_type": true, "_score": true, "highlight": true, "sort": true, "_source": true, "host": true, "manager.name": true, "id": true, "input.type": true, "decoder.name": true, "rule.mail": true, "rule.firedtimes": true, "predecoder.program_name": true, "rule.pci_dss": true, "rule.gdpr": true, "rule.hipaa": true, "rule.nist_800_53": true, "rule.tsc": true, "rule.mitre.id": true, "rule.mitre.tactic": true, "rule.mitre.technique": true },
            "indexByName": {
              "@timestamp": 0,
              "rule.id": 1,
              "data.Severity": 2,
              "data.CheckTitle": 3,
              "data.ControlID": 4,
              "data.Provider": 5,
              "agent.name": 6,
              "rule.description": 7
            },
            "renameByName": {
              "@timestamp": "Time",
              "rule.id": "Rule",
              "data.Severity": "Severity",
              "data.CheckTitle": "Check / Control",
              "data.ControlID": "Control ID",
              "data.Provider": "Provider",
              "agent.name": "Agent",
              "rule.description": "Description"
            }
          }
        }
      ]
    },
    {
      "type": "row",
      "title": "Scanner liveness (operational context)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 37 },
      "collapsed": true,
      "panels": [
        {
          "title": "Prowler last run",
          "description": "Time since last successful Prowler scan. Stale data invalidates the compliance posture above.",
          "type": "stat",
          "gridPos": { "h": 5, "w": 6, "x": 0, "y": 38 },
          "datasource": { "type": "prometheus", "uid": "${ds_prom}" },
          "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 86400 }, { "color": "red", "value": 172800 } ] }, "unit": "s" } },
          "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
          "targets": [ { "expr": "time() - max(kube_cronjob_status_last_successful_time{cronjob=\"prowler-soc2-scan\"})", "refId": "A" } ]
        },
        {
          "title": "Kubescape last run",
          "type": "stat",
          "gridPos": { "h": 5, "w": 6, "x": 6, "y": 38 },
          "datasource": { "type": "prometheus", "uid": "${ds_prom}" },
          "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 86400 }, { "color": "red", "value": 172800 } ] }, "unit": "s" } },
          "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
          "targets": [ { "expr": "time() - max(kube_cronjob_status_last_successful_time{cronjob=\"kubescape-scan\"})", "refId": "A" } ]
        },
        {
          "title": "kube-bench last run",
          "type": "stat",
          "gridPos": { "h": 5, "w": 6, "x": 12, "y": 38 },
          "datasource": { "type": "prometheus", "uid": "${ds_prom}" },
          "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 86400 }, { "color": "red", "value": 172800 } ] }, "unit": "s" } },
          "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
          "targets": [ { "expr": "time() - max(kube_cronjob_status_last_successful_time{cronjob=\"kube-bench-cis-scan\"})", "refId": "A" } ]
        },
        {
          "title": "TruffleHog last run",
          "type": "stat",
          "gridPos": { "h": 5, "w": 6, "x": 18, "y": 38 },
          "datasource": { "type": "prometheus", "uid": "${ds_prom}" },
          "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 86400 }, { "color": "red", "value": 172800 } ] }, "unit": "s" } },
          "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
          "targets": [ { "expr": "time() - max(kube_cronjob_status_last_successful_time{cronjob=\"trufflehog-secret-scan\"})", "refId": "A" } ]
        },
        {
          "title": "Wazuh manager up",
          "type": "stat",
          "gridPos": { "h": 5, "w": 12, "x": 0, "y": 43 },
          "datasource": { "type": "prometheus", "uid": "${ds_prom}" },
          "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }, "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ], "unit": "none" } },
          "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
          "targets": [ { "expr": "min(up{job=~\"wazuh-manager.*\"})", "refId": "A" } ]
