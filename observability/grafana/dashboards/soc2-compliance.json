{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "SOC 2 control compliance posture over time. Pulls Prowler / Kubescape / kube-bench / TruffleHog / FIM findings from the Wazuh indexer (wazuh-alerts-*) and surfaces pass/fail rates, severity trends, top failing controls and recent critical findings.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "Posture (current window)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "title": "Open Critical SOC2 Findings",
      "description": "Critical SOC2 findings raised by Wazuh (rule.groups:soc2_critical) in the window.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "${ds_wazuh}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 } ] },
          "unit": "short",
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        {
          "refId": "A",
          "query": "rule.groups:soc2_critical",
          "alias": "critical",
          "metrics": [ { "type": "count", "id": "1" } ],
          "bucketAggs": [ { "type": "date_histogram", "field": "@timestamp", "id": "2", "settings": { "interval": "auto", "min_doc_count": "0" } } ],
          "timeField": "@timestamp"
        }
      ]
    },
    {
      "title": "Open High SOC2 Findings",
      "description": "High-severity SOC2 control failures (rule.groups:soc2_fail AND data.Severity in {high,High}).",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "${ds_wazuh}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 10 }, { "color": "orange", "value": 50 }, { "color": "red", "value": 200 } ] },
          "unit": "short",
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        {
          "refId": "A",
          "query": "rule.groups:soc2_fail AND data.Severity:(high OR High)",
          "alias": "high",
          "metrics": [ { "type": "count", "id": "1" } ],
          "bucketAggs": [ { "type": "date_histogram", "field": "@timestamp", "id": "2", "settings": { "interval": "auto", "min_doc_count": "0" } } ],
          "timeField": "@timestamp"
        }
      ]
    },
    {
      "title": "Total SOC2 Failures",
      "description": "All SOC2 control failures in the window (rule.groups:soc2_fail). Spans Prowler, Kubescape, kube-bench, TruffleHog, FIM, Grype.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "${ds_wazuh}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 50 }, { "color": "orange", "value": 200 }, { "color": "red", "value": 1000 } ] },
          "unit": "short"
        }
      },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        {
          "refId": "A",
          "query": "rule.groups:soc2_fail",
          "alias": "fail",
          "metrics": [ { "type": "count", "id": "1" } ],
          "bucketAggs": [ { "type": "date_histogram", "field": "@timestamp", "id": "2", "settings": { "interval": "auto", "min_doc_count": "0" } } ],
          "timeField": "@timestamp"
        }
      ]
    },
    {
      "title": "Prowler Outcomes (window)",
      "description": "PASS / FAIL / WARN counts for Prowler SOC2 checks in the selected window. The split is the cloud-control compliance posture.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "${ds_wazuh}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] },
          "unit": "short",
          "mappings": []
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "(?i)PASS" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
          { "matcher": { "id": "byRegexp", "options": "(?i)FAIL" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] },
          { "matcher": { "id": "byRegexp", "options": "(?i)WARN" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] }
        ]
      },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value_and_name", "orientation": "vertical", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        {
          "refId": "A",
          "query": "rule.groups:prowler_compliance",
          "alias": "{{term data.Status}}",
          "metrics": [ { "type": "count", "id": "1" } ],
          "bucketAggs": [
            { "type": "terms", "field": "data.Status", "id": "3", "settings": { "size": "5", "order": "desc", "orderBy": "_count" } }
          ],
          "timeField": "@timestamp"
        }
      ]
    },
    {
      "title": "Verified Secret Leaks",
      "description": "TruffleHog verified secret findings (rule.id:100601). Verified=true means the credential is currently usable.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "${ds_wazuh}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] },
          "unit": "short", "color": { "mode": "thresholds" }
        }
      },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        {
          "refId": "A",
          "query": "rule.id:100601",
          "alias": "verified",
          "metrics": [ { "type": "count", "id": "1" } ],
          "bucketAggs": [ { "type": "date_histogram", "field": "@timestamp", "id": "2", "settings": { "interval": "auto", "min_doc_count": "0" } } ],
          "timeField": "@timestamp"
        }
      ]
    },
    {
      "title": "FIM / Secret events (CC6.1)",
      "description": "File-integrity-monitoring and credential exposure events (rule.groups: syscheck OR secret_leak OR credential_exposure). Trust criterion CC6.1.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "${ds_wazuh}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 10 }, { "color": "red", "value": 100 } ] },
          "unit": "short"
        }
      },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        {
          "refId": "A",
          "query": "rule.groups:(syscheck OR secret_leak OR credential_exposure)",
          "alias": "fim",
          "metrics": [ { "type": "count", "id": "1" } ],
          "bucketAggs": [ { "type": "date_histogram", "field": "@timestamp", "id": "2", "settings": { "interval": "auto", "min_doc_count": "0" } } ],
          "timeField": "@timestamp"
        }
      ]
    },
    {
      "type": "row",
      "title": "Compliance trend",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "collapsed": false
    },
    {
      "title": "Prowler PASS vs FAIL over time",
      "description": "Time series of Prowler check outcomes. Rising green / shrinking red = improving cloud control compliance.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "${ds_wazuh}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 80, "stacking": { "mode": "normal", "group": "A" } },
          "unit": "short"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "PASS" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
          { "matcher": { "id": "byName", "options": "FAIL" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] },
          { "matcher": { "id": "byName", "options": "WARN" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum", "lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "query": "rule.groups:prowler_compliance",
          "alias": "{{term data.Status}}",
          "bucketAggs": [
            { "type": "terms", "field": "data.Status", "id": "3", "settings": { "size": "5", "order": "desc", "orderBy": "_count" } },
            { "type": "date_histogram", "field": "@timestamp", "id": "2", "settings": { "interval": "auto", "min_doc_count": "0" } }
          ],
          "metrics": [ { "type": "count", "id": "1" } ],
          "timeField": "@timestamp"
        }
      ]
    },
    {
      "title": "SOC2 failures by severity over time",
      "description": "All SOC2 control failures (rule.groups:soc2_fail) bucketed by data.Severity. Tracks whether the overall posture is improving.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "${ds_wazuh}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 80, "stacking": { "mode": "normal", "group": "A" } },
          "unit": "short"
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "(?i)^critical$" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] },
          { "matcher": { "id": "byRegexp", "options": "(?i)^high$" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] },
          { "matcher": { "id": "byRegexp", "options": "(?i)^medium$" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } } ] },
          { "matcher": { "id": "byRegexp", "options": "(?i)^low$" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "query": "rule.groups:soc2_fail",
          "alias": "{{term data.Severity}}",
          "bucketAggs": [
            { "type": "terms", "field": "data.Severity", "id": "3", "settings": { "size": "10", "order": "desc", "orderBy": "_count", "missing": "unknown" } },
            { "type": "date_histogram", "field": "@timestamp", "id": "2", "settings": { "interval": "auto", "min_doc_count": "0" } }
          ],
          "metrics": [ { "type": "count", "id": "1" } ],
          "timeField": "@timestamp"
        }
      ]
    },
    {
      "type": "row",
      "title": "Top failing controls & scanners",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "collapsed": false
    },
    {
      "title": "Top 10 failing Prowler checks",
      "description": "Most frequent failing cloud controls in the window (data.CheckTitle).",
      "type": "bargauge",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "${ds_wazuh}" },
      "fieldConfig": {
        "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 5 }, { "color": "red", "value": 20 } ] }, "unit": "short" }
      },
      "options": { "orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true, "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        {
          "refId": "A",
          "query": "rule.groups:prowler_compliance AND data.Status:FAIL",
          "alias": "{{term data.CheckTitle}}",
          "bucketAggs": [
            { "type": "terms", "field": "data.CheckTitle", "id": "3", "settings": { "size": "10", "order": "desc", "orderBy": "_count", "missing": "(no title)" } }
          ],
          "metrics": [ { "type": "count", "id": "1" } ],
          "timeField": "@timestamp"
        }
      ]
    },
    {
      "title": "Failures by scanner",
      "description": "Share of SOC2 failures contributed by each scanner. Helps identify which control area drives most of the open findings.",
      "type": "piechart",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "${ds_wazuh}" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] }, "pieType": "donut", "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" } },
      "targets": [
        {
          "refId": "A",
          "query": "rule.groups:soc2_fail",
          "alias": "{{term data.Scanner}}",
          "bucketAggs": [
            { "type": "terms", "field": "data.Scanner", "id": "3", "settings": { "size": "10", "order": "desc", "orderBy": "_count", "missing": "(no scanner)" } }
          ],
          "metrics": [ { "type": "count", "id": "1" } ],
          "timeField": "@timestamp"
        }
      ]
    },
    {
      "type": "row",
      "title": "Recent critical findings",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 },
      "collapsed": false
    },
    {
      "title": "Latest critical / high SOC2 findings",
      "description": "Most recent critical or high findings (rule.groups:soc2_fail AND severity critical|high). Use this list to drive remediation.",
      "type": "table",
      "gridPos": { "h": 11, "w": 24, "x": 0, "y": 26 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "${ds_wazuh}" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "filterable": true } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Severity" }, "properties": [ { "id": "custom.cellOptions", "value": { "type": "color-background" } } ] }
        ]
      },
      "options": { "showHeader": true, "sortBy": [ { "displayName": "Time", "desc": true } ] },
      "targets": [
        {
          "refId": "A",
          "query": "rule.groups:soc2_fail AND data.Severity:(critical OR Critical OR high OR High)",
          "alias": "",
          "metrics": [ { "type": "raw_document", "id": "1", "settings": { "size": "100" } } ],
          "bucketAggs": [],
          "timeField": "@timestamp"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "_id": true, "_index": true, "_type": true, "_score": true, "highlight": true, "sort": true, "_source": true, "host": true, "manager.name": true, "id": true, "input.type": true, "decoder.name": true, "rule.mail": true, "rule.firedtimes": true, "predecoder.program_name": true, "rule.pci_dss": true, "rule.gdpr": true, "rule.hipaa": true, "rule.nist_800_53": true, "rule.tsc": true, "rule.mitre.id": true, "rule.mitre.tactic": true, "rule.mitre.technique": true },
            "indexByName": {
              "@timestamp": 0,
              "data.Severity": 1,
              "data.Scanner": 2,
              "data.CheckTitle": 3,
              "data.ControlID": 4,
              "data.Cluster": 5,
              "rule.description": 6
            },
            "renameByName": {
              "@timestamp": "Time",
              "data.Severity": "Severity",
              "data.Scanner": "Scanner",
              "data.CheckTitle": "Check / Control",
              "data.ControlID": "Control ID",
              "data.Cluster": "Cluster",
              "rule.description": "Description"
            }
          }
        }
      ]
    },
    {
      "type": "row",
      "title": "Scanner liveness (operational context)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 37 },
      "collapsed": true,
      "panels": [
        {
          "title": "Prowler last run",
          "description": "Time since last successful Prowler scan. Stale data invalidates the compliance posture above.",
          "type": "stat",
          "gridPos": { "h": 5, "w": 6, "x": 0, "y": 38 },
          "datasource": { "type": "prometheus", "uid": "${ds_prom}" },
          "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 86400 }, { "color": "red", "value": 172800 } ] }, "unit": "s" } },
          "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
          "targets": [ { "expr": "time() - max(kube_cronjob_status_last_successful_time{cronjob=\"prowler-soc2-scan\"})", "refId": "A" } ]
        },
        {
          "title": "Kubescape last run",
          "type": "stat",
          "gridPos": { "h": 5, "w": 6, "x": 6, "y": 38 },
          "datasource": { "type": "prometheus", "uid": "${ds_prom}" },
          "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 86400 }, { "color": "red", "value": 172800 } ] }, "unit": "s" } },
          "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
          "targets": [ { "expr": "time() - max(kube_cronjob_status_last_successful_time{cronjob=\"kubescape-scan\"})", "refId": "A" } ]
        },
        {
          "title": "kube-bench last run",
          "type": "stat",
          "gridPos": { "h": 5, "w": 6, "x": 12, "y": 38 },
          "datasource": { "type": "prometheus", "uid": "${ds_prom}" },
          "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 86400 }, { "color": "red", "value": 172800 } ] }, "unit": "s" } },
          "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
          "targets": [ { "expr": "time() - max(kube_cronjob_status_last_successful_time{cronjob=\"kube-bench-cis-scan\"})", "refId": "A" } ]
        },
        {
          "title": "TruffleHog last run",
          "type": "stat",
          "gridPos": { "h": 5, "w": 6, "x": 18, "y": 38 },
          "datasource": { "type": "prometheus", "uid": "${ds_prom}" },
          "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 86400 }, { "color": "red", "value": 172800 } ] }, "unit": "s" } },
          "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
          "targets": [ { "expr": "time() - max(kube_cronjob_status_last_successful_time{cronjob=\"trufflehog-secret-scan\"})", "refId": "A" } ]
        },
        {
          "title": "Grype last run",
          "description": "Time since last successful Grype vulnerability scan.",
          "type": "stat",
          "gridPos": { "h": 5, "w": 12, "x": 0, "y": 43 },
          "datasource": { "type": "prometheus", "uid": "${ds_prom}" },
          "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 86400 }, { "color": "red", "value": 172800 } ] }, "unit": "s" } },
          "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
          "targets": [ { "expr": "time() - max(kube_cronjob_status_last_successful_time{cronjob=~\"grype-.*\"})", "refId": "A" } ]
        },
        {
          "title": "Wazuh agents reporting",
          "type": "stat",
          "gridPos": { "h": 5, "w": 12, "x": 12, "y": 43 },
          "datasource": { "type": "prometheus", "uid": "${ds_prom}" },
          "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 1 }, { "color": "green", "value": 3 } ] }, "unit": "short" } },
          "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
          "targets": [ { "expr": "sum(kube_daemonset_status_number_ready{daemonset=\"wazuh-agent\"})", "refId": "A" } ]
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["soc2", "compliance", "security", "wazuh", "prowler", "kubescape", "kube-bench", "trufflehog"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "WazuhIndexer", "value": "WazuhIndexer" },
        "hide": 0,
        "includeAll": false,
        "label": "Wazuh indexer",
        "multi": false,
        "name": "ds_wazuh",
        "query": "grafana-opensearch-datasource",
        "type": "datasource"
      },
      {
        "current": { "selected": false, "text": "VictoriaMetrics", "value": "VictoriaMetrics" },
        "hide": 0,
        "includeAll": false,
        "label": "Metrics",
        "multi": false,
        "name": "ds_prom",
        "query": "prometheus",
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-7d", "to": "now" },
  "timepicker": {},
  "timezone": "utc",
  "title": "SOC 2 Compliance Overview",
  "uid": "soc2-compliance-overview",
  "version": 3
}
